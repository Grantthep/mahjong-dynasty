{
  "name": "@mahjong/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser client for Mahjong Dynasty: Dragon Fortune (React + Phaser 3).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
