# Copy this file to `.env` (copy .env.example .env) and adjust.
# NEVER commit the real .env file.

# --- Database (matches docker-compose.yml and `npm run db:embedded`) ---
DATABASE_URL=postgresql://mahjong:mahjong@localhost:5432/mahjong_dynasty?schema=public

# --- Auth ---
# Use a long random string (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Servers ---
API_PORT=4000
# Origin allowed by CORS (the Vite dev server)
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Optional ---
# Number of reverse proxies in front of the API (1 behind nginx). Leave 0 when not proxied.
# TRUST_PROXY=0
# bcrypt cost factor (default 12; tests use 4)
# BCRYPT_ROUNDS=12
# Web build only: absolute API URL when NOT using the Vite proxy
# VITE_API_URL=http://localhost:4000
